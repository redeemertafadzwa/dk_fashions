# Copy this file to ".env" and edit, then restart the server.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# ---- Promo code (checkout discount) ----
PROMO_CODE=NUST000
PROMO_DISCOUNT_PERCENT=20

# ---- Email: fill these to send REAL confirmation codes ----
# Leave blank to print codes to the server console (dev mode).
# For Gmail, create an App Password (Google Account > Security > App passwords).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DK Fashions <no-reply@dkfashions.com>

# ---- Database (SQLite by default) ----
# To use MySQL: set DB_ENGINE=mysql and fill the rest.
DB_ENGINE=sqlite
DB_NAME=dk_fashions
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
